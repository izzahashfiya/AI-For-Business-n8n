    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(item => item.json);\n\nconst total = rows.length;\nconst counts = {\n  Positive: 0,\n  Negative: 0,\n  Neutral: 0,\n};\n\nfor (const row of rows) {\n  const text = String(\n    row.Sentiment ?? row.sentiment ?? \"\"\n  );\n\n  const match = text.match(\n    /\\b(Positive|Negative|Neutral)\\b/i\n  );\n\n  if (match) {\n    const label =\n      match[1][0].toUpperCase() +\n      match[1].slice(1).toLowerCase();\n\n    counts[label]++;\n  }\n}\n\nconst labeledTotal =\n  counts.Positive + counts.Negative + counts.Neutral;\n\nconst percent = count =>\n  labeledTotal\n    ? Number((count / labeledTotal * 100).toFixed(1))\n    : 0;\n\nreturn [{\n  json: {\n  \"totalBerita\": 10,\n  \"totalBeritaBerlabel\": 10,\n  \"positive\": 6,\n  \"negative\": 3,\n  \"neutral\": 1,\n  \"persenPositive\": 60,\n  \"persenNegative\": 30,\n  \"persenNeutral\": 10\n}\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
